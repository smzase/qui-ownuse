# Go tooling writes LF and gofmt normalises it, so a file committed with CRLF
# shows up as a whole-file diff the first time anyone formats it.
*.go text eol=lf

# Snapshot comparisons require the same line endings on Windows and Unix.
*.golden text eol=lf

# Generated output is checked byte-for-byte against the generator.
documentation/docs/_partials/_automations-json-reference.mdx text eol=lf
web/src/components/query-builder/fields.generated.ts text eol=lf
web/src/lib/preference-catalog-keys.json text eol=lf
